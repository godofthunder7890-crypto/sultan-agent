# ─── REQUIRED ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here       # BotFather se milta hai

# ─── AI (kam se kam ek API key daalo) ────────────────────────
GROQ_API_KEY=gsk_...                         # groq.com/keys — FREE
GEMINI_API_KEY=AIzaSy...                     # aistudio.google.com — FREE
OPENAI_API_KEY=sk-...                        # platform.openai.com — Paid

# ─── Firebase (optional, messages save karne ke liye) ─────────
FIREBASE_API_KEY=AIzaSy...                   # Firebase Console > Project Settings
FIREBASE_PROJECT_ID=your-project-id          # Firebase Console > Project Settings
FIREBASE_USER_ID=sultan                      # Firestore mein kahan save ho (default: sultan)

# ─── Bot Settings ─────────────────────────────────────────────
AI_REPLY_ENABLED=true                        # true = bot AI se reply kare | false = sirf save kare
