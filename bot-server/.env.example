# Sultan Agent Bot Server v6.0 — Environment Variables
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Local dev ke liye: cp .env.example .env
# Railway ke liye: Dashboard > Variables mein daalo
# Replit ke liye: Secrets tab mein daalo
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ─── Telegram Bot (@BotFather se milta hai) ──────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ADMIN_CHAT_ID=your_telegram_chat_id_here

# ─── AI Providers — Groq → Gemini → OpenAI chain ─
# Groq (FREE): console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Gemini (FREE): aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (paid): platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# ─── Web Search (FREE tier): serper.dev ──────────
SERPER_API_KEY=your_serper_api_key_here

# ─── Voice — JARVIX: elevenlabs.io ───────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ─── Firebase (already hardcoded, can override) ───
FIREBASE_API_KEY=AIzaSyBPQxmPvldjJ5Zt03E5i2xrrhFWpdpYd-s
FIREBASE_PROJECT_ID=v11345
