{
  "expo": {
    "name": "Sultan Agent",
    "slug": "sultan-agent",
    "owner": "blcobra858",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sultan-agent",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080B14"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sultan.agent",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Sultan Agent needs mic for voice.",
        "NSSpeechRecognitionUsageDescription": "Sultan Agent uses voice to talk with AI."
      }
    },
    "android": {
      "package": "com.sultan.agent",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#080B14"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-av",
        {
          "microphonePermission": "Sultan Agent needs microphone for voice conversations."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "kotlinVersion": "1.9.24",
            "javaVersion": "17"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "72bd2537-674f-4d3b-b6b3-6969b43350f0"
      }
    }
  }
}